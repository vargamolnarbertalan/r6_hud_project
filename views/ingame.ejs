<!DOCTYPE html>
<html>

<head>
  <title>R6 HUD INGAME</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
  <link rel="stylesheet" href="/css/ingame.css">
  <link rel="icon" type="image/x-icon" href="/img/favicon.ico">
</head>

<body>

  <div class="camera">
    <% for (let i = 0; i < 10; i++) { %>
      <div id="container<%= i %>" class="player-container">
        <iframe id="spec_pos<%= i %>" class="player-iframe" frameBorder="0" src=""></iframe>
        <img id="spec_pos<%= i %>_pic" class="player-avatar" src="" alt="Player <%= i %> avatar">
      </div>
    <% } %>
  </div>

  <div class="name_bg"></div>
  <div id="team_color_bar" class="team_color_bar team-color-blue"></div>

  <div class="info_div">
    <div class="info_row">
      <img id="team_logo" class="team_logo" src="" alt="">
      <div id="player_name" class="PLAYERNAME"></div>
      <img id="player_flag" class="player_flag" src="" alt="">
    </div>
  </div>

</body>

<script>

$(document).ready(function(){

  const teamConfig = {
    0: 'blue', 1: 'blue', 2: 'blue', 3: 'blue', 4: 'blue',
    5: 'orange', 6: 'orange', 7: 'orange', 8: 'orange', 9: 'orange'
  };

  const teamColorClass = {
    blue: 'team-color-blue',
    orange: 'team-color-orange'
  };

  var playerData = [];
  var teamLogos = [];

  $.ajax({
    url: "/fill/ingame",
    type: "POST",
    success: function(data) {
      playerData = data;
      for (var i = 0; i < data.length; i++) {
        $('#spec_pos' + i).prop('src', data[i].view_link + '&transparent&cover&cleanoutput?autoplay=on');
        $('#spec_pos' + i + '_pic').prop('src', data[i].avatar);
      }
      selectPosition(0);
    }
  });

  $.ajax({
    url: "/fill/fs_team",
    type: "POST",
    success: function(data) {
      for (var i = 0; i < data.length; i++) {
        teamLogos[i] = data[i].logo;
      }
      if (playerData.length) {
        selectPosition(0);
      }
    }
  });

  const ws = new WebSocket("ws://localhost:6969");

  ws.addEventListener("open", () => {
    console.log("Connected!");

    ws.onmessage = function(e){
      var server_message = e.data;
      console.log(server_message);

      if (server_message == "c") {
        $('body').css('opacity','1');
      }
      else if (server_message == "x") {
        $('body').css('opacity','0');
      }
      else if (server_message == "force_hide") {
        $('body').css('opacity','0');
      }
      else if (server_message == "force_show") {
        $('body').css('opacity','1');
      }
      else if (server_message == "reload_view") {
        location.reload();
      }
      else if (server_message.startsWith("select_pos")) {
        const pos = parseInt(server_message.replace("select_pos", ""), 10);
        selectPosition(pos);
      }
    }
  });

  function selectPosition(pos) {
    $('.player-container').css('opacity', '0');
    $('.player-avatar').css('opacity', '0');

    $('#container' + pos).css('opacity', '1');
    $('#spec_pos' + pos + '_pic').css('opacity', '1');

    if (!playerData[pos]) {
      return;
    }

    const team = teamConfig[pos];
    $('#team_color_bar')
      .removeClass('team-color-blue team-color-orange')
      .addClass(teamColorClass[team]);
    $('#player_name').text(playerData[pos].nickname);

    const teamIndex = team === 'blue' ? 0 : 1;
    if (teamLogos[teamIndex]) {
      $('#team_logo').prop('src', teamLogos[teamIndex]);
    }
    if (playerData[pos].nationality) {
      $('#player_flag').prop('src', playerData[pos].nationality);
    }
  }

});

</script>

</html>
