<!DOCTYPE html>
<html>

<head>
  <title>R6 HUD INGAME</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
  <link rel="stylesheet" href="/css/ingame.css">
  <link rel="icon" type="image/x-icon" href="/img/favicon.ico">
</head>

<body>

  <!-- Team 1 (Blue) - Players 0-4 -->
  <div id="team-border-0" class="team-border team-border-blue">
    <% for(let i = 0; i < 5; i++) { %>
      <div id="container<%= i %>" class="player-container">
        <iframe id="spec_pos<%= i %>" class="player-iframe" frameBorder="0" src=""></iframe>
      </div>
    <% } %>
  </div>

  <!-- Team 2 (Orange) - Players 5-9 -->
  <div id="team-border-1" class="team-border team-border-orange">
    <% for(let i = 5; i < 10; i++) { %>
      <div id="container<%= i %>" class="player-container">
        <iframe id="spec_pos<%= i %>" class="player-iframe" frameBorder="0" src=""></iframe>
      </div>
    <% } %>
  </div>

  <!-- Avatar images (fallback for disconnected streams) -->
  <% for(let i = 0; i < 10; i++) { %>
    <img id="spec_pos<%= i %>_pic" class="player-avatar" src="" alt="Player <%= i %> avatar">
  <% } %>

</body>

<script>

$(document).ready(function(){

  // Team configuration: which team border to show for each position
  const teamConfig = {
    0: 'blue', 1: 'blue', 2: 'blue', 3: 'blue', 4: 'blue',
    5: 'orange', 6: 'orange', 7: 'orange', 8: 'orange', 9: 'orange'
  };

  // Load player data and setup initial state
  $.ajax({
    url: "/fill/ingame",
    type: "POST",
    success: function(data) {
      for (var i = 0; i < data.length; i++) {
        $('#spec_pos' + i).prop('src', data[i].view_link + '&transparent&cover&cleanoutput?autoplay=on');
        $('#spec_pos' + i + '_pic').prop('src', data[i].avatar);
      }
      // Initialize with position 0 visible
      selectPosition(0);
    }
  });

  const ws = new WebSocket("ws://localhost:6969");

  ws.addEventListener("open", () => {
    console.log("Connected!");

    ws.onmessage = function(e){
      var server_message = e.data;
      console.log(server_message);
      
      if (server_message == "c") {
        $('body').css('opacity','1');
      }
      else if (server_message == "x") {
        $('body').css('opacity','0');
      }
      else if (server_message == "force_hide") {
        $('body').css('opacity','0');
      }
      else if (server_message == "force_show") {
        $('body').css('opacity','1');
      }
      else if (server_message == "reload_view") {
        location.reload();
      }
      // Handle position selection
      else if (server_message.startsWith("select_pos")) {
        const pos = parseInt(server_message.replace("select_pos", ""));
        selectPosition(pos);
      }
    }
  });

  // DRY function to select a position
  function selectPosition(pos) {
    // Hide all containers and avatars
    $('.player-container').css('opacity', '0');
    $('.player-avatar').css('opacity', '0');
    
    // Hide all team borders
    $('.team-border').css('opacity', '0');
    
    // Show selected team border
    if (teamConfig[pos] === 'blue') {
      $('#team-border-0').css('opacity', '1');
    } else {
      $('#team-border-1').css('opacity', '1');
    }
    
    // Show selected position
    $('#container' + pos).css('opacity', '1');
    $('#spec_pos' + pos + '_pic').css('opacity', '1');
  }

});

</script>

</html>
