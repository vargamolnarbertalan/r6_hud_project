# R6 HUD Database Configuration
# Copy this file to .env and fill in your database credentials

# MySQL Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=r6_hud

# Optional: VDO.ninja Streaming Parameters
# These parameters are appended to all player view links
# Examples:
#   &quality=1 - Set quality level
#   &autoplay=on - Auto-play video streams
#   &mutespeaker - Mute audio output
#   &cover - Cover entire container
#   &cleanoutput - Hide VDO.ninja UI elements
VIDEO_PARAMS=

# Notes:
# - DB_NAME must exist before starting the app
# - Import schema from misc\r6_hud.sql to create tables
# - VIDEO_PARAMS is optional but useful for production
# - Rotation parameters are set per-player in match control

